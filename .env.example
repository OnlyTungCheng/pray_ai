# Đền Cầu Nguyện — required environment variables.
# Copy this file to .env and fill in real values from your Supabase project
# (Project Settings -> API). Never commit .env.

# Public Supabase project URL. Safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=

# Public/publishable anon key. Safe to expose to the browser — RLS policies
# (see supabase/migrations/0001_temple_core_schema.sql) enforce access control.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only service role key. NEVER prefix with NEXT_PUBLIC_ and never use it
# in a Client Component — it bypasses Row Level Security entirely.
# Only add this if/when a server-side task genuinely needs to bypass RLS
# (not currently required by any route handler in this project).
# SUPABASE_SERVICE_ROLE_KEY=

# Cloudflare Turnstile site key, used to CAPTCHA-protect anonymous sign-in
# (see src/features/auth/anonymous-captcha-gate.tsx). Optional locally — if
# unset, the sign-in flow skips the challenge and works normally, UNLESS
# "Enable CAPTCHA protection" is turned on for this project in the Supabase
# Dashboard (Auth -> Bot and Abuse Protection), in which case it's required.
# Get a site key at https://dash.cloudflare.com/?to=/:account/turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
