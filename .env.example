# Đền Cầu Nguyện — required environment variables.
# Copy this file to .env and fill in real values from your Supabase project
# (Project Settings -> API). Never commit .env.

# Public Supabase project URL. Safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=

# Public/publishable anon key. Safe to expose to the browser — RLS policies
# (see supabase/migrations/0001_temple_core_schema.sql) enforce access control.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only service role key. NEVER prefix with NEXT_PUBLIC_ and never use it
# in a Client Component — it bypasses Row Level Security entirely.
# Only add this if/when a server-side task genuinely needs to bypass RLS
# (not currently required by any route handler in this project).
# SUPABASE_SERVICE_ROLE_KEY=

# Cloudflare Turnstile site key, used to CAPTCHA-protect anonymous sign-in
# (see src/features/auth/anonymous-captcha-gate.tsx). Optional locally — if
# unset, the sign-in flow skips the challenge and works normally, UNLESS
# "Enable CAPTCHA protection" is turned on for this project in the Supabase
# Dashboard (Auth -> Bot and Abuse Protection), in which case it's required.
# Get a site key at https://dash.cloudflare.com/?to=/:account/turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Direct Postgres connection string, used ONLY by dev-time scripts
# (scripts/migrate.mjs, scripts/seed.mjs) to apply
# supabase/migrations/{schema,seed}/*.sql. NOT used by the app itself at
# runtime — the app only ever talks to Supabase via NEXT_PUBLIC_SUPABASE_URL
# + the publishable key above.
#
# `npm run db:seed` (schema-safe, idempotent data seeding) auto-runs on every
# `npm run dev`/`npm run build` via predev/prebuild — including on Vercel, if
# this variable is set there. `npm run db:migrate` (schema/DDL changes) is
# NOT wired into any build hook and must be run manually from a developer's
# own machine — see ALLOW_PROD_MIGRATE below for the safeguard that enforces
# this even if that ever changes. See docs/backend.md §3 for the full
# schema-vs-seed explanation.
#
# Get this from Supabase Dashboard -> Connect -> "Session pooler" (works
# from IPv4-only networks) or "Direct connection" (requires IPv6 or the
# IPv4 add-on). If left unset, both scripts silently skip and you fall back
# to running the SQL files by hand in the SQL Editor — nothing breaks either way.
# DATABASE_URL=postgresql://postgres.<project-ref>:<url-encoded-password>@<pooler-host>.pooler.supabase.com:6543/postgres

# Safeguard: scripts/migrate.mjs refuses to run schema/DDL migrations when it
# detects a Vercel production build (VERCEL_ENV=production, set automatically
# by Vercel — not something you need to set yourself), UNLESS this is
# explicitly set to "true". This exists so a production build can never
# accidentally apply schema changes — migrations are meant to be run by hand
# from a developer's machine. Leave this unset; only set it temporarily if
# you have a deliberate, understood reason to run db:migrate against
# production from within a Vercel build (not recommended).
# ALLOW_PROD_MIGRATE=true
